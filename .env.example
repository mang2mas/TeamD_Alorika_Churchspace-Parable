# Copy to .env.local. Not used until Phase 1 (Supabase); the app runs on seed data today.
#
# NEVER put secrets in VITE_* variables: Vite inlines them into the public JS bundle.
# Server-only keys (Supabase service role, Anthropic, Resend, VAPID private) live in
# Supabase Edge Function secrets, never in this file. See docs/ROADMAP.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

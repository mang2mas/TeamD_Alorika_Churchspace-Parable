[
  {
    "name": "Initial JS (shell + store, gzip)",
    "path": "dist/assets/index-*.js",
    "limit": "150 kB",
    "gzip": true
  },
  {
    "name": "All lazy chunks (apps, PNG export, gzip)",
    "path": ["dist/assets/*.js", "!dist/assets/index-*.js"],
    "limit": "60 kB",
    "gzip": true
  },
  {
    "name": "CSS (gzip)",
    "path": "dist/assets/*.css",
    "limit": "20 kB",
    "gzip": true
  }
]
